# Copy this file to ".env" for local development (optional — the app runs without it).
# In production (Vercel) set these in the project's Environment Variables instead.

# Secret used to sign login sessions. Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: a hosted Postgres URL for permanent data (see DEPLOY.md).
# Leave unset to use the built-in file store.
# DATABASE_URL="postgres://..."
